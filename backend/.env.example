PORT=4000
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/colmeia
JWT_SECRET=troque-isso-por-um-segredo-bem-grande-e-aleatorio

# ---- Discord ----
# Bot (atendimento via ticket): quando o cliente aceita o orçamento, o bot abre um
# canal/ticket com as infos do model. Sem DISCORD_BOT_TOKEN, roda em modo simulação.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_CONVITE=

# Dados do Pix mostrados no ticket para o cliente pagar a entrada (50%). Vazio = não exibe.
PIX_CHAVE=
PIX_NOME=

# Login/cadastro via Discord (OAuth2 — mesma aplicação do bot). Sem CLIENT_ID/SECRET,
# o login por Discord fica desativado (o login por e-mail continua funcionando).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
# IDs de Discord dos artistas (viram admin ao entrar), separados por vírgula:
DISCORD_ADMIN_IDS=

# Imagens do catálogo: com CLOUDINARY_URL, o upload vai pro Cloudinary (persistente,
# recomendado em prod). Vazio = salva no disco local (some em redeploy no Render free).
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# CORS: em produção, coloque a URL do frontend (separe por vírgula se houver mais de uma).
# Vazio = libera qualquer origem (só use em desenvolvimento).
CORS_ORIGIN=

# Admin inicial criado pelo seed (npm run seed)
ADMIN_EMAIL=admin@colmeia.com
ADMIN_SENHA=colmeia123

# E-mail / notificações (opcional). Sem SMTP_USER/SMTP_PASS, roda em modo
# simulação (apenas loga no console). Para Gmail use uma "senha de app".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Colmeia <seu-email@gmail.com>
EMAIL_ARTISTA=
APP_URL=http://localhost:5173
