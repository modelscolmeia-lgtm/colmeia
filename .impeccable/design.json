  "narrative": {
    "northStar": "A Vitrine do Artista",
    "overview": "A Colmeia é uma loja de arte encomendada, e a arte do artista é a estrela. A interface é a prateleira: ameixa escura de fundo, mel como cor da marca e cores de apoio que se acendem só onde há informação. O pixel é a assinatura; o resto é de loja.",
    "keyCharacteristics": [
      "Fundo ameixa com mel como única cor de marca.",
      "Cantos retos, borda grossa e sombra pixel em tudo que é clicável.",
      "Imagem grande no centro de cada produto.",
      "Dois temas completos, escuro padrão e claro em lavanda."
    ],
    "rules": [
      {
        "name": "The Honey Is The Brand Rule",
        "body": "O mel é a marca. Se algo precisa se destacar e não é seleção, ação principal ou marca, não é mel.",
        "section": "colors"
      },
      {
        "name": "The Function Before Color Rule",
        "body": "Menta, céu, coral e violeta só entram com função.",
        "section": "colors"
      },
      {
        "name": "The Two Themes Rule",
        "body": "Toda cor existe nos dois temas, com contraste mínimo de 4,5:1 para texto.",
        "section": "colors"
      },
      {
        "name": "The One Pixel Voice Rule",
        "body": "Uma fonte só; peso e tamanho constroem a hierarquia.",
        "section": "typography"
      },
      {
        "name": "The Press Down Rule",
        "body": "Ao clicar, o objeto desce 3px e perde a sombra.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar mel só para marca, seleção e ação principal.",
      "Do mostrar preço em todo card de produto.",
      "Do manter borda grossa, canto reto e sombra pixel em tudo que é clicável."
    ],
    "donts": [
      "Don't usar gradiente, vidro ou cantos arredondados.",
      "Don't usar emoji como ícone estrutural.",
      "Don't transformar o pedido em criador de personagem interativo."
    ]
  }
